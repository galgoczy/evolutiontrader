<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.evolutiontrader.paper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/ops/run-paper.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>UV_BIN</key>
        <string>__UV__</string>
        <key>PATH</key>
        <string>__PATHDIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>3</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__LOGDIR__/paper.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/paper.err.log</string>
</dict>
</plist>
